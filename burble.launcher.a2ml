#
# burble.launcher.a2ml — per-app launcher config for Burble voice/media.
# Compliant with launcher-standard_praxis.deed v0.4.0

[project]
name         = "burble"
display      = "Burble"
description  = "Self-hostable Elixir control plane + WebRTC media server"
categories   = ["Network", "AudioVideo", "Development"]
version      = "0.1.0"
license      = "MPL-2.0"

[repo]
# NOTE: repo-dir is resolved at runtime from the launcher script location.
# Do NOT hardcode absolute paths. Leave empty or use relative paths.
path = ""

[runtime]
kind    = "server-url"
port    = 6473
url     = "http://localhost:6473"
command = ["env", "MIX_ENV=dev", "mix", "phx.server"]
# Per launcher-standard_praxis.deed (runtime ...) clause:
# PID files MUST use XDG_RUNTIME_DIR or TMPDIR, NEVER /tmp directly
# Log files MUST use XDG_STATE_HOME, NEVER /tmp directly
pid-file = "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/burble-server.pid"
log-file = "${XDG_STATE_HOME:-$HOME/.local/state}/burble/server.log"
wait-for-url-timeout-seconds = 20

[version-output]
# Per launcher-standard_praxis.deed (version-output ...) clause
first-line-format = "burble {version} ({build-sha-short}) [{platform}]"
example = "burble 0.1.0 (abc1234) [linux-x86_64]"
exit-code = 0

[icon]
source = "{repo-dir}/assets/icon-256.png"
