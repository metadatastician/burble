//
// E2EE.affine — DISABLED placeholder. The real implementation is e2ee.js.
//
// See E2EE.res for the full account: this module claimed AES-256-GCM and
// encrypted with a repeating-key XOR against the local private key, nothing
// imported it, and its generated output does not even parse. It is kept as a
// failing stub so the path sends the next reader to the real module.
//
// The real implementation is client/web/e2ee.js (WebCrypto X25519 +
// HKDF-SHA256 + AES-256-GCM), pinned against the server's output by
// tests/fixtures/e2ee-vectors.json. Frames are not yet encrypted on the call
// path — the WebRTC Encoded Transform wiring is not written (ADR-0016 §Gaps).

/// E2EE is not available from this module.
type state = Disabled

let disabledMessage = "[Burble:E2EE] client/web/src/app/voice/E2EE is a disabled placeholder; use client/web/e2ee.js"

/// Always fails. Kept so any existing call site fails loudly rather than
/// transmitting plaintext.
let initialize = (): result<state, string> => raise(Failure(disabledMessage))
