// SPDX-License-Identifier: MPL-2.0
//
// E2EE.affine — DISABLED placeholder. The implementation is client/web/e2ee.js.
//
// This module used to claim AES-256-GCM with HKDF-SHA256 and encrypt each frame
// by XORing it with the local private key, repeated. It derived its key from one
// peer's private key with no agreement step, nothing imported it, and the build
// artifact it produced referenced three identifiers that did not exist. It was
// harmless by luck, not design.
//
// It is kept as a failing stub so a call site breaks loudly instead of sending
// plaintext, and so the next reader is sent to the real module:
//
//   implementation   client/web/e2ee.js          (WebCrypto, covered by the 97-test web suite)
//   key exchange     client/web/e2ee-session.js
//   protocol         docs/decisions/0016-peer-held-group-keys.adoc
//
// Frames are NOT yet encrypted on the call path. ADR-0016 §Gaps tracks that.
//
// Syntax note: this file was previously ReScript. Renaming `.res` to `.affine`
// does not make AffineScript — see upstream docs/ON-RAMP.adoc. This file follows
// the shape of upstream's CI-gated consumer example
// (examples/consumers/extension-boundary/src/boundary.affine): no imports, no
// host externs, integer status codes.

module E2EE;

// Status code returned by every entry point here: 0 would mean "encryption is
// available and configured", which is never true for this module.
pub fn disabled() -> Int {
  1
}

// Whether this module can encrypt anything. It cannot, and saying so as a
// function — rather than by absence — is what makes the disabled state visible
// to a call site.
pub fn is_available() -> Bool {
  false
}
