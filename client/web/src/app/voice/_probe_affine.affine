// TEMPORARY syntax probe — deleted as soon as the canary reports.
// Exact shape of upstream's CI-gated consumer example, module renamed.
module probe_affine;

pub fn is_ok(status: Int) -> Bool {
  status == 0
}

pub fn detect(n: Int) -> Int {
  let status = n;
  if is_ok(status) { 0 } else { 1 }
}

pub fn message() -> String {
  "probe"
}
