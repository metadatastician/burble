{
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ],
    "strict": true
  },
  "imports": {
    "@rescript/core": "npm:@rescript/core@1.6.1",
    "@rescript/runtime": "npm:@rescript/runtime@12.2.0",
    "rescript": "npm:rescript@12.2.0",
    "phoenix": "npm:phoenix@1.7.11",
    "cadre-router": "../../../developer-ecosystem/rescript-ecosystem/cadre-router/src/client/CadreRouter.js",
    "vite": "npm:vite@6.2.0"
  },
  "tasks": {
    "res:build": "bun run res:build",
    "res:build:deno": "deno run --node-modules-dir=auto --allow-read --allow-write --allow-env --allow-run npm:rescript@12.2.0",
    "res:dev": "bun run res:dev",
    "dev": "bun run dev",
    "build": "bun run build",
    "test": "bun run test",
    "test:deno": "deno test --no-check --node-modules-dir=auto --allow-read --allow-env --allow-run=deno --allow-net=127.0.0.1,localhost tests/"
  }
}
